# SmartLight OS — Backend API Environment Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Security & JWT Authentication
JWT_SECRET=dev-jwt-secret-smartlight-os-do-not-use-in-production-2026
JWT_EXPIRES_IN=24h

# PostgreSQL Database (with PostGIS extension)
DATABASE_URL=postgresql://smartlight:local_dev_secret_2026@localhost:5432/smartlight

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# MQTT Broker (Eclipse Mosquitto / EMQX)
MQTT_URL=mqtt://localhost:1883
