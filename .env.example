# ==============================================================================
# SmartLight OS — Environment Configuration Template
# ==============================================================================

# Node Environment & Logging
NODE_ENV=development
LOG_LEVEL=debug
PORT=4000

# Security & Authentication (Scaffolded for Dev)
# In production, replace with minimum 32-character high-entropy secret or OIDC/MFA provider
JWT_SECRET=dev-jwt-secret-smartlight-os-do-not-use-in-production-2026
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL 16 with PostGIS)
DATABASE_URL=postgresql://smartlight:local_dev_secret_2026@localhost:5432/smartlight
POSTGRES_DB=smartlight
POSTGRES_USER=smartlight
POSTGRES_PASSWORD=local_dev_secret_2026
POSTGRES_PORT=5432

# Redis & BullMQ
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# MQTT Broker (Eclipse Mosquitto / EMQX)
MQTT_URL=mqtt://localhost:1883
MQTT_PORT=1883

# Hardware Abstraction & Simulator Layer
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_MS=5000

# Web Application (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_ULB_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
